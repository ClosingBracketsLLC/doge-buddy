{
  "name": "@doge-buddy/storefront",
  "private": true,
  "sideEffects": false,
  "version": "2026.4.6",
  "type": "module",
  "scripts": {
    "build": "shopify hydrogen build --codegen --path \"$(pwd)\" --no-lockfile-check",
    "dev": "shopify hydrogen dev --codegen --path \"$(pwd)\"",
    "preview": "shopify hydrogen preview --build --path \"$(pwd)\"",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "codegen": "shopify hydrogen codegen --path \"$(pwd)\" && react-router typegen",
    "test": "vitest run",
    "smoke": "playwright test"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@doge-buddy/core": "workspace:*",
    "@shopify/hydrogen": "2026.4.5",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "isbot": "^5.1.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.16.0",
    "react-router-dom": "7.16.0",
    "tailwindcss": "^4.1.6"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@graphql-codegen/cli": "5.0.2",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "7.16.0",
    "@react-router/fs-routes": "7.16.0",
    "@shopify/cli": "3.93.2",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "4.2.2",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@shopify/prettier-config": "^1.1.2",
    "@tailwindcss/vite": "^4.1.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "graphql-config": "^5.0.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.9.2",
    "vite": "^8.0.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "browserslist": [
    "defaults"
  ]
}
