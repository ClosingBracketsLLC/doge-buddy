DATABASE_URL=postgres://doge:doge@localhost:5433/doge_buddy
PORT=3001

# Bind address for the HTTP server (default: 0.0.0.0 — keep for container/Railway deploys)
# HOST=0.0.0.0

# Which SupplierAdapter backs the fulfillment queues (place/pay-order, sync-tracking,
# reconcile): mock | cj (default: mock). 'cj' requires CJ_API_KEY and CJ_OPEN_ID below.
# FULFILLMENT_SUPPLIER=mock

# Public base URL of this ops app (e.g. the Railway URL). Used by the daily Shopify
# webhook-audit cron as the webhook callback base (<ADMIN_BASE_URL>/webhooks/shopify) —
# subscriptions on managed topics pointing elsewhere are pruned. Only takes effect when the
# SHOPIFY_* block is also set; must be http(s) and publicly reachable by Shopify.
# ADMIN_BASE_URL=https://ops.example.com

# Shopify Admin API credentials — all four are required together, or leave all unset.
# SHOPIFY_SHOP_DOMAIN must be the *.myshopify.com domain, never a custom domain (the custom
# domain 301-redirects /admin/oauth/access_token, which breaks the token exchange).
# SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_WEBHOOK_SECRET=

# CJ Dropshipping API credentials — both are required together. CJ_OPEN_ID is the account's
# numeric openId (only obtainable via GET /setting/get — the dashboard never shows it); it is
# also the HMAC key CJ webhook verification uses.
# CJ_API_KEY=
# CJ_OPEN_ID=

# Telegram owner notifications — both required together. Create a bot via @BotFather; the chat
# id is your DM chat with it (message the bot once, then GET /getUpdates shows chat.id).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
